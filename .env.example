# Gnani AI Sovereign Artha Stack Credentials
KADAL_GNANI_API_KEY=your_gnani_api_key_here

# Prisma v2.5 VAD tuning. Every value here overrides its default without a code change;
# benchmark/run_eval.py also takes --vad-threshold and --min-speech-ms for one run.
KADAL_VAD_THRESHOLD=0.78
KADAL_MIN_SPEECH_MS=200
KADAL_MIN_SILENCE_MS=360

# Dev only, off by default: save each live mic session's raw audio (a recording of a real voice)
# plus where each Prisma segment arrived, to diagnose clipping. Replay with scripts/replay_mic_capture.py.
# KADAL_MIC_CAPTURE_DIR=mic_captures

# Deterministic Credit Firewall & Confidence Gate
KADAL_CONFIDENCE_THRESHOLD=0.82
KADAL_DB_PATH=kadal_kural.db

# Phone channel (Gnani Agent Builder On-Call action -> POST /api/v1/phone-turn).
# Long random secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Empty keeps the endpoint disabled (503).
KADAL_PHONE_WEBHOOK_TOKEN=

# Security (defaults are safe; see SECURITY.md).
# Other host names that may serve the desk directly, comma-separated (e.g. a LAN address).
# KADAL_ALLOWED_HOSTS=192.168.1.20
# Phone channel requests per minute per caller address (0 disables the limit).
# KADAL_PHONE_RATE_LIMIT_PER_MINUTE=60
# KADAL_MAX_PHONE_BODY_BYTES=32768
# KADAL_MAX_UPLOAD_BYTES=10485760
# A live microphone session closes after this many seconds.
# KADAL_LIVE_SESSION_MAX_SECONDS=1200
