# Gnani AI Sovereign Artha Stack Credentials
KADAL_GNANI_API_KEY=your_gnani_api_key_here

# Prisma v2.5 VAD tuning. Every value here overrides its default without a code change;
# benchmark/run_eval.py also takes --vad-threshold and --min-speech-ms for one run.
KADAL_VAD_THRESHOLD=0.78
KADAL_MIN_SPEECH_MS=200
KADAL_MIN_SILENCE_MS=360

# Deterministic Credit Firewall & Confidence Gate
KADAL_CONFIDENCE_THRESHOLD=0.82
KADAL_DB_PATH=kadal_kural.db
